# Base URL of the recsterio backend API (include /api/v1).
# Leave unset for the normal setup: the dev server proxies /api to the backend,
# and the deployed dashboard is served from the same origin as the API.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to 1 to force the bundled mock API even without ?mock=1 in the URL
VITE_USE_MOCK=0
